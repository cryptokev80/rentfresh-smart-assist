# Copy to .env and fill in. Never commit .env.
# RentFresh Smart Assist — concierge MVP

# --- WhatsApp Cloud API (from Meta developer dashboard) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=

# --- Behavior ---
# DRY_RUN=true logs outgoing WhatsApp messages instead of sending them.
# Use it for testing without touching Meta's API.
DRY_RUN=true
PORT=3000

# --- Persistence (production) ---
# Mount a Railway volume (e.g. at /data) and set DATA_DIR=/data so tickets
# and conversations survive redeploys. Defaults to the repo directory.
DATA_DIR=

# --- Inbox protection (optional but recommended on a public server) ---
INBOX_USER=
INBOX_PASS=

# --- NEEDS YOU email alerts (optional but recommended) ---
# Free Resend account (https://resend.com) signed up with the ALERT_EMAIL
# address. Without a verified domain, Resend only delivers to the account
# owner's address, which is exactly where these alerts go.
RESEND_API_KEY=
ALERT_EMAIL=rentfreshteam@gmail.com
ALERT_FROM=RentFresh Alerts <onboarding@resend.dev>
# Public inbox URL used in alert emails. Falls back to RAILWAY_PUBLIC_DOMAIN.
INBOX_URL=

# --- AI vision for photo triage (optional) ---
# Any OpenAI-compatible chat/completions endpoint. Leave blank to run
# rule-based triage only; photo senders will be asked to describe the issue.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o-mini
